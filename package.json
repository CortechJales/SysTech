{
  "name": "systech",
  "version": "1.2.0",
  "description": "Sistema de Gestão SysTech",
  "main": "electron/main.js",
  "author": "Rafael Corturato",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "web": "nodemon server.js --ignore public --ignore frontend",
    "electron": "electron . --no-sandbox --disable-setuid-sandbox",
    "dev": "webpack -w",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.corturato.systech",
    "productName": "SysTech",
    "asar": true,
    "extraResources": [
      ".env"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist",
      "!node_modules/.cache",
      "!frontend",
      "!.git"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "executableName": "systech"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^6.0.0",
    "core-js": "^3.48.0",
    "css-loader": "^7.1.3",
    "csurf": "^1.11.0",
    "dotenv": "^17.2.3",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "mongoose": "^9.1.6",
    "regenerator-runtime": "^0.14.1",
    "style-loader": "^4.0.0",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "babel-loader": "^10.0.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.1.11",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  }
}