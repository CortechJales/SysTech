<%- include('../includes/head')%>
<%- include('../includes/nav')%>

<div class="container my-4">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 fw-bold mb-0">Catálogo de Produtos</h1>
                <a href="/produto/new" class="btn btn-primary">+ Novo Produto</a>
            </div>

            <%- include('../includes/messages') %>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark text-nowrap">
                        <tr>
                            <th width="80">Código</th>
                            <th>Descrição</th>
                            <th>Valor de Venda</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(produtos.length > 0) { %>
                            <% produtos.forEach(p => { %>
                                <tr>
                                    <td class="fw-bold text-primary">#<%= p.codigo %></td>
                                    <td><%= p.descricao %></td>
                                    <td>R$ <%= Number(p.valorVenda).toFixed(2) %></td>
                                    <td class="text-center">
                                        <span class="badge bg-success">Ativo</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a href="/produto/load/<%= p._id %>" class="btn btn-warning ms-2">Editar</a>
                                            <a href="/produto/delete/<%= p._id %>" class="btn btn-danger ms2" onclick="return confirm('Tem certeza que deseja inativar este produto?')">Inativar</a>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-4">Nenhum produto ativo encontrado.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../includes/footer')%>