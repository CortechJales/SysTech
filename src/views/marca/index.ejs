<%- include('../includes/head')%>
  <%- include('../includes/nav')%>
    <div class="Container">
      <div class="row">
        <div class="col-lg-2"></div>

        <div class="col-lg-8 my-3">
          <h1 class="text-center">Marcas</h1>
          <p class="text-center lead">Suas marcas estão abaixo</p>

          <%- include('../includes/messages') %>
            <% if(marcas.length>0){%>
              <div class="responsive-table">
                <table class="table my-3">
                  <% marcas.forEach(marca=>{ %>
                    <tr>
                      <td>
                        <%=marca.descricao%>
                      </td>                                         
                      <td><a href="/marca/index/<%=marca._id%>">Editar</a></td>
                      <td><a class="text-danger" href="/marca/delete/<%=marca._id%>">Deletar</a></td>

                    </tr>
                    <%}) %>

                </table>
              </div>
              <%}else{%>
                <p class="text-center lead">Não existem marcas cadastradas</p>
              <%} %>


        </div>

        <div class="col-lg-2"></div>
      </div>
    </div>

    <%- include('../includes/footer')%>