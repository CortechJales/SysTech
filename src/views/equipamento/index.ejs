<%- include('../includes/head')%>
<%- include('../includes/nav')%>

<div class="container">
  <div class="row">
    <div class="col-lg-12 my-3">
      <h1 class="text-center">Equipamentos em Manutenção</h1>
      <p class="text-center lead">Gestão de Computadores e Notebooks</p>

      <%- include('../includes/messages') %>

      <% if(equipamentos.length > 0) { %>
        <div class="table-responsive shadow-sm">
          <table class="table table-hover mt-3 align-middle">
            <thead class="table-dark">
              <tr>
                <th>Data</th>
                <th>Cliente</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Configuração</th>
                <th class="text-center">Status</th>
                <th class="text-center">Ações</th>
              </tr>
            </thead>
            <tbody>
              <% equipamentos.forEach(equip => { %>
                <tr>
                  <td class="small"><%= equip.criadoEm.toLocaleDateString('pt-BR') %></td>
                  
                  <td><strong><%= equip.cliente ? equip.cliente.nome : 'Cliente removido' %></strong></td>
                  
                  <td><%= equip.marca ? equip.marca.descricao : 'Sem marca' %></td>
                  
                  <td><%= equip.modelo %></td>
                  
                  <td class="small text-muted"><%= equip.configuracao %></td>
                  
                  <td class="text-center">
                    <span class="badge <%= equip.ativo ? 'bg-success' : 'bg-secondary' %>">
                      <%= equip.ativo ? 'Oficina' : 'Entregue' %>
                    </span>
                  </td>

                  <td class="text-center">
                    <div class="btn-group btn-group-sm">
                      <a href="/os/index/<%= equip.cliente?._id %>/<%= equip._id %>" class="btn btn-primary ms-1" title="Abrir OS/Orçamento">
                        + Nova OS
                      </a>
                      
                      <a href="/equipamento/load/<%= equip._id %>" class="btn btn-warning ms-1">Editar</a>
                      <a href="/equipamento/delete/<%= equip._id %>" class="btn btn-danger ms-1">Excluir</a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="alert alert-info text-center">Nenhum equipamento encontrado para este critério.</div>
      <% } %>

      <div class="mt-3">
         <a href="/cliente/list" class="btn btn-outline-secondary">Voltar para Clientes</a>
      </div>
    </div>
  </div>
</div>

<%- include('../includes/footer')%>