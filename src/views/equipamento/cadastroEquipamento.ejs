<%- include('../includes/head')%>
<%- include('../includes/nav')%>
<div class="container">
  <div class="row">
    <div class="col-lg-2"></div>
    <div class="col-lg-8 my-3">
      <h1 class="text-center">Equipamento (TI)</h1>
      <p class="text-center lead">Dados do Computador/Notebook</p>
      <%- include('../includes/messages') %>

      <% if(equipamento._id){ %>
        <form action="/equipamento/edit/<%= equipamento._id %>" method="post">
      <% } else { %>
        <form action="/equipamento/register" method="post">
      <% } %>
        <input type="hidden" name="_csrf" value="<%=csrfToken %>">
        <input type="hidden" name="cliente" value="<%= clienteId %>">

        <div class="card shadow-sm">
          <div class="card-body">
            <div class="row">
              <div class="col-md-8 mb-3">
                <label class="form-label">Modelo / Identificação</label>
                <input type="text" value="<%= equipamento.modelo %>" class="form-control" name="modelo" placeholder="Ex: Notebook Dell G15" required>
              </div>
              <div class="col-md-4 mb-3">
                <label class="form-label">Marca</label>
                <select name="marca" class="form-control" required>
                  <option value="">-- Selecione --</option>
                  <% marcas.forEach(marca => { %>
                    <option value="<%= marca._id %>" <%= (equipamento.marca && equipamento.marca.toString() === marca._id.toString()) ? 'selected' : '' %>>
                      <%= marca.descricao %>
                    </option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label">Configuração Técnica</label>
              <input type="text" value="<%= equipamento.configuracao %>" class="form-control" name="configuracao" placeholder="Ex: Core i7, 16GB RAM, SSD 512GB">
            </div>

            <div class="mb-3">
              <label class="form-label">Defeito Relatado</label>
              <textarea name="defeito" class="form-control" rows="3"><%= equipamento.defeito %></textarea>
            </div>

            <div class="mb-3">
              <label class="form-label">Status</label>
              <select name="ativo" class="form-control">
                <option value="true" <%= equipamento.ativo !== false ? 'selected' : '' %>>Em Manutenção</option>
                <option value="false" <%= equipamento.ativo === false ? 'selected' : '' %>>Entregue</option>
              </select>
            </div>

            <hr>
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
              <a href="/cliente/list" class="btn btn-secondary">Voltar</a>
              <button type="submit" class="btn btn-primary px-5">Salvar Equipamento</button>
            </div>
          </div>
        </div>
      </form>
    </div>
    <div class="col-lg-2"></div>
  </div>
</div>
<%- include('../includes/footer')%>