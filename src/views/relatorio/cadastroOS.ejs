<%- include('../includes/head')%>
<%- include('../includes/nav')%>

<% const isFechado = (os.status === 'Fechado'); %>

<div class="container my-4">
    <div class="row">
        <div class="col-lg-12">
            <%- include('../includes/messages') %>
        </div>
    </div>

    <form action="<%= os._id ? '/os/edit/' + os._id : '/os/register' %>" method="post" class="form-os">
        <input type="hidden" name="_csrf" value="<%=csrfToken %>">
        <input type="hidden" name="cliente" value="<%= cliente._id %>">
        <input type="hidden" name="equipamento" value="<%= equipamento._id %>">

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                
                <div class="row mb-4 align-items-center">
                    <div class="col-md-6">
                        <h2 class="text-primary fw-bold">Gestão de Ordem de Serviço</h2>
                        <span class="badge bg-light text-dark border">Cliente: <%= cliente.nome %></span>
                        <span class="badge bg-light text-dark border">Equipamento: <%= equipamento.modelo %></span>
                    </div>
                    <div class="col-md-6 text-end">
                        <label class="fw-bold d-block mb-1 small">Status do Fluxo</label>
                        <select name="status" class="form-select w-auto d-inline-block border-primary fw-bold" <%= isFechado ? 'disabled' : '' %>>
                            <% ['Em orçamento', 'Aguardando cliente', 'Em execução', 'Atendido', 'Fechado'].forEach(st => { %>
                                <option value="<%= st %>" <%= os.status === st ? 'selected' : '' %>><%= st %></option>
                            <% }) %>
                        </select>
                        <% if(isFechado) { %> <input type="hidden" name="status" value="Fechado"> <% } %>
                    </div>
                </div>

                <div class="row g-3 mb-4 p-3 bg-light rounded shadow-sm">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small">Data Início</label>
                        <input type="date" name="data_inicio" class="form-control" value="<%= os.data_inicio ? os.data_inicio.toISOString().split('T')[0] : '' %>" <%= isFechado ? 'readonly' : '' %>>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small">Data Final</label>
                        <input type="date" name="data_final" class="form-control" value="<%= os.data_final ? os.data_final.toISOString().split('T')[0] : '' %>" <%= isFechado ? 'readonly' : '' %>>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small">Orçamento Passado</label>
                        <input type="date" name="data_orcamento_passado" class="form-control" value="<%= os.data_orcamento_passado ? os.data_orcamento_passado.toISOString().split('T')[0] : '' %>" <%= isFechado ? 'readonly' : '' %>>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small">Orçamento Aprovado</label>
                        <input type="date" name="data_orcamento_aprovado" class="form-control" value="<%= os.data_orcamento_aprovado ? os.data_orcamento_aprovado.toISOString().split('T')[0] : '' %>" <%= isFechado ? 'readonly' : '' %>>
                    </div>
                </div>

                <h5 class="fw-bold mb-3"><i class="bi bi-box-seam"></i> Peças e Serviços</h5>
                <div class="row g-2 mb-3 bg-white border p-3 rounded shadow-sm">
                    <div class="col-md-7">
                        <label class="form-label small fw-bold text-muted">Filtrar por Código ou Nome</label>
                        <input type="text" id="filtro-produto" class="form-control mb-2" placeholder="Digite para pesquisar..." <%= isFechado ? 'disabled' : '' %>>
                        
                        <select id="sel-prod" class="form-select" <%= isFechado ? 'disabled' : '' %>>
                            <option value="">-- Selecione o item --</option>
                            <% produtos.forEach(p => { %>
                                <option value="<%= p.descricao %>" data-valor="<%= p.valorVenda %>" data-search="<%= p.codigo %> <%= p.descricao.toLowerCase() %>">
                                    #<%= p.codigo %> - <%= p.descricao %> (R$ <%= p.valorVenda.toFixed(2) %>)
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-muted">Qtd</label>
                        <input type="number" id="sel-qtd" class="form-control" value="1" min="1" <%= isFechado ? 'disabled' : '' %>>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label d-none d-md-block">&nbsp;</label>
                        <button type="button" id="btn-add-item" class="btn btn-success w-100" <%= isFechado ? 'disabled' : '' %>>
                             <i class="bi bi-plus-circle"></i> Adicionar
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-4">
                        <thead class="table-light">
                            <tr>
                                <th>Descrição</th>
                                <th width="100">Qtd</th>
                                <th width="180">Valor Unit. (R$)</th>
                                <th>Subtotal</th>
                                <th width="50"></th>
                            </tr>
                        </thead>
                        <tbody id="corpo-itens">
                            <% os.itens.forEach((item, i) => { %>
                                <tr>
                                    <td>
                                        <input type="hidden" name="itens[<%=i%>][descricao]" value="<%=item.descricao%>">
                                        <%=item.descricao%>
                                    </td>
                                    <td>
                                        <input type="number" name="itens[<%=i%>][quantidade]" class="form-control form-control-sm input-qtd" value="<%=item.quantidade%>" <%= isFechado ? 'readonly' : '' %>>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">R$</span>
                                            <input type="number" step="0.01" name="itens[<%=i%>][valorUnitario]" class="form-control input-valor" value="<%=item.valorUnitario%>" <%= isFechado ? 'readonly' : '' %>>
                                        </div>
                                    </td>
                                    <td class="subtotal-item fw-bold">R$ <%= (item.quantidade * item.valorUnitario).toFixed(2) %></td>
                                    <td>
                                        <% if(!isFechado) { %>
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-remover border-0"><i class="bi bi-trash"></i></button>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Total em Peças:</td>
                                <td colspan="2" class="fw-bold text-primary">R$ <span id="total_pecas">0.00</span></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="row g-4">
                    <div class="col-md-7">
                        <label class="fw-bold mb-2">Observações Internas / Laudo Técnico</label>
                        <textarea name="observacao" class="form-control" rows="5" placeholder="Descreva detalhes..." <%= isFechado ? 'readonly' : '' %>><%= os.observacao %></textarea>
                    </div>
                    <div class="col-md-5">
                        <div class="p-4 border rounded bg-light shadow-sm">
                            <div class="mb-3">
                                <label class="fw-bold form-label">Mão de Obra (R$)</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text">R$</span>
                                    <input type="number" step="0.01" name="mao_de_obra" id="mao_obra" class="form-control border-primary" value="<%= os.mao_de_obra || 0 %>" <%= isFechado ? 'readonly' : '' %>>
                                </div>
                            </div>
                            <hr>
                            <div class="text-end">
                                <span class="text-muted small d-block mb-1">Total Geral</span>
                                <h2 class="text-success fw-bold mb-0">R$ <span id="total_exibido">0.00</span></h2>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-4">
                <div class="d-flex justify-content-between">
                    <a href="/os/list" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left"></i> Voltar</a>
                    <% if(!isFechado) { %>
                        <button type="submit" class="btn btn-primary btn-lg px-5 shadow"><i class="bi bi-save"></i> Salvar Registro</button>
                    <% } else { %>
                        <div class="alert alert-warning mb-0 p-2 px-3 fw-bold"><i class="bi bi-lock-fill"></i> OS FINALIZADA (SOMENTE LEITURA)</div>
                    <% } %>
                </div>
            </div>
        </div>
    </form>
</div>

<%- include('../includes/footer')%>