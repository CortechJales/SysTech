<%- include('../includes/head') %>
    <%- include('../includes/nav') %>

        <div class="container my-4">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h1 class="h3 fw-bold mb-4">Histórico de Ordens de Serviço</h1>

                    <!-- Filtros -->
                    <form action="/relatorio" method="POST" class="row g-3 mb-4">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <!-- Data Início -->
                        <div class="col-md-3">
                            <label class="form-label">Data Início</label>
                            <input type="date" name="dataInicio" class="form-control" value="<%= filtros.dataInicio %>">
                        </div>

                        <!-- Data Fim -->
                        <div class="col-md-3">
                            <label class="form-label">Data Fim</label>
                            <input type="date" name="dataFim" class="form-control" value="<%= filtros.dataFim %>">
                        </div>

                        <!-- Cliente -->
                        <div class="col-md-3">
                            <label class="form-label">Cliente</label>
                            <input type="text" name="nomeCliente" class="form-control"
                                value="<%= filtros.nomeCliente %>">
                        </div>

                        <!-- Equipamento -->
                        <div class="col-md-3">
                            <label class="form-label">Equipamento</label>
                            <input type="text" name="equipamento" class="form-control"
                                value="<%= filtros.equipamento %>">
                        </div>

                        <!-- Valor Mínimo -->
                        <div class="col-md-3">
                            <label class="form-label">Valor Mínimo (R$)</label>
                            <input type="number" name="valorMin" step="0.01" class="form-control"
                                value="<%= filtros.valorMin %>">
                        </div>

                        <!-- Valor Máximo -->
                        <div class="col-md-3">
                            <label class="form-label">Valor Máximo (R$)</label>
                            <input type="number" name="valorMax" step="0.01" class="form-control"
                                value="<%= filtros.valorMax %>">
                        </div>

                        <!-- Item -->
                        <div class="col-md-3">
                            <label class="form-label">Item</label>
                            <input type="text" name="item" class="form-control" value="<%= filtros.item %>">
                        </div>

                        <!-- Status -->
                        <div class="col-md-3">
                            <label class="form-label d-block **fw-bold**">Status</label>
                            <div class="row">
                                <% const statusOptions=['Em orçamento', 'Aguardando cliente' , 'Em execução'
                                    , 'Atendido' , 'Fechado' ]; %>
                                    <% statusOptions.forEach(statusOption=> { %>
                                        <div class="col-12"> <!-- Mude para col-6 se quiser duas colunas lado a lado -->
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="status"
                                                    value="<%= statusOption %>"
                                                    id="status-<%= statusOption.replace(/\s+/g, '') %>"
                                                    <%=filtros.status.includes(statusOption) ? 'checked' : '' %>>
                                                <label class="form-check-label"
                                                    for="status-<%= statusOption.replace(/\s+/g, '') %>">
                                                    <%= statusOption %>
                                                </label>
                                            </div>
                                        </div>
                                        <% }); %>
                            </div>
                        </div>

                        <!-- Botões -->
                        <div class="col-12 mt-2">
                            <button type="submit" class="btn btn-primary">Filtrar</button>
                            <a href="/relatorio" class="btn btn-outline-secondary">Limpar</a>
                        </div>
                    </form>

                    <!-- Tabela de resultados -->
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-dark text-nowrap">
                                <tr>
                                    <th>Início</th>
                                    <th>Cliente</th>
                                    <th>Equipamento</th>
                                    <th>Status</th>
                                    <th>Aprovado em</th>
                                    <th>Valor Total</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (dados && dados.length> 0) { %>
                                    <% dados.forEach(os=> { %>
                                        <tr>
                                            <td class="small">
                                                <%= os.data_inicio ? new
                                                    Date(os.data_inicio).toLocaleDateString('pt-BR') : '--' %>
                                            </td>
                                            <td><strong>
                                                    <%= os.cliente?.nome || '-' %>
                                                </strong></td>
                                            <td class="small">
                                                <%= os.equipamento?.modelo || '-' %>
                                            </td>
                                            <td>
                                                <span class="badge rounded-pill 
                                            <%= os.status === 'Em orçamento' ? 'bg-warning text-dark' : 
                                                os.status === 'Fechado' ? 'bg-dark' : 'bg-primary' %>">
                                                    <%= os.status %>
                                                </span>
                                            </td>
                                            <td class="small text-muted text-center">
                                                <%= os.data_orcamento_aprovado ? new
                                                    Date(os.data_orcamento_aprovado).toLocaleDateString('pt-BR') : '-'
                                                    %>
                                            </td>
                                            <td class="fw-bold">
                                                R$ <%= (os.valorTotalGeral || 0).toFixed(2) %>
                                            </td>
                                            <td>
                                                <a href="/os/load/<%= os._id %>" class="btn btn-sm btn-outline-primary">
                                                    Abrir
                                                </a>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="7" class="text-center text-muted">Nenhum resultado
                                                        encontrado</td>
                                                </tr>
                                                <% } %>
                            </tbody>
                            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                        </table>
                    </div>

                    <div class="row">
                        <div class="col-md-3 mb-5">
                            <h5 class="text-center">Relação de OS por status</h5>
                            <canvas id="graficoStatus"></canvas>
                        </div>

                        <div class="col-md-9 mb-5">
                            <h5 class="text-center">Serviços realizados por dia</h5>
                            <canvas id="graficoDias"></canvas>
                        </div>
                        <div class="col-md-4 ">
                            <h5 class="text-center">Faturamento por Status OS</h5>
                            <canvas id="graficoTotal"></canvas>
                        </div>
                        <div class="col-md-8 mb-5">
                            <h5 class="text-center">Serviços/troca mais realizados</h5>
                            <canvas id="graficoItens"></canvas>
                        </div>
                        <div class="col-md-12 mb-5">
                            <h5 class="text-center">Composição de Faturamento por OS (Peças vs Mão de Obra)</h5>
                            <canvas id="graficoComposicao"></canvas>
                        </div>
                        <div class="col-md-6 mb-5">
                            <h5 class="text-center">Distribuição Geral: Mão de Obra vs Peças</h5>
                            <canvas id="graficoGeralComposicao"></canvas>
                        </div>
                        <div class="col-md-6 mb-5">
                            <h5 class="text-center">Novos Clientes vs. Clientes Antigos</h5>
                            <canvas id="graficoNovosClientes"></canvas>
                        </div>
                    </div>
                    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

                    <script id="dados-json" type="application/json">
                        <%- JSON.stringify(dados || []) %>
                    </script>

                    <script>
                        const coresGlobal = {
                            maoDeObra: '#28a745', // Verde
                            pecas: '#007bff',     // Azul
                            status: {
                                'Em orçamento': '#ffc107',
                                'Aguardando cliente': '#36A2EB',
                                'Em execução': '#4BC0C0',
                                'Atendido': '#0d6efd',
                                'Fechado': '#333333'
                            }
                        };
                        geraGraficos();

                        function geraGraficos() {
                            const dadosJson = document.getElementById('dados-json');
                            if (!dadosJson) return;

                            const dados = JSON.parse(dadosJson.textContent);
                            const inputInicio = document.getElementsByName('dataInicio')[0];
                            const dataInicioFiltro = inputInicio ? inputInicio.value : null;

                            criaGraficoStatus(dados);
                            criaGraficoData(dados);
                            criaGraficoTotalStatus(dados);
                            criaGraficoItens(dados);
                            criaGraficoComposicao(dados);
                            criaGraficoGeralComposicao(dados);
                            criaGraficoClientesNovos(dados, dataInicioFiltro);
                        };

                        function criaGraficoStatus(dados) {
                            const statusCount = {};
                            let totalOS = dados.length;

                            dados.forEach(os => {
                                statusCount[os.status] = (statusCount[os.status] || 0) + 1;
                            });

                            new Chart(document.getElementById('graficoStatus'), {
                                type: 'pie',
                                data: {
                                    labels: Object.keys(statusCount),
                                    datasets: [{
                                        label: 'OS por Status',
                                        data: Object.values(statusCount),
                                        backgroundColor: Object.keys(statusCount).map(s => coresGlobal.status[s] || '#999')
                                    }]
                                },
                                options: {
                                    plugins: {
                                        tooltip: {
                                            callbacks: {
                                                label: function(context) {
                                                    let label = context.label || '';
                                                    let value = context.raw || 0;
                                                    let percentage = totalOS > 0 ? ((value / totalOS) * 100).toFixed(1) : 0;
                                                    return `${label}: ${value} OS (${percentage}%)`;
                                                }
                                            }
                                        }
                                    }
                                }
                            });
                        }

                      function criaGraficoData(dados) {
                        const dateCount = {};
                        
                        // Ordenar os dados por data para a linha não ficar "puxando" para trás e para frente
                        const dadosOrdenados = [...dados].sort((a, b) => new Date(a.data_inicio) - new Date(b.data_inicio));

                        dadosOrdenados.forEach(os => {
                            const data = new Date(os.data_inicio).toLocaleDateString('pt-BR');
                            dateCount[data] = (dateCount[data] || 0) + 1;
                        });

                        new Chart(document.getElementById('graficoDias'), {
                            type: 'line',
                            data: {
                                labels: Object.keys(dateCount),
                                datasets: [{
                                    label: 'Qtd de OS',
                                    data: Object.values(dateCount),
                                    borderColor: coresGlobal.pecas, // Cor da linha
                                    backgroundColor: coresGlobal.pecas + '33', // Cor de fundo leve (opcional)
                                    borderWidth: 4, // Linha mais grossa
                                    fill: true, // Preenche a área abaixo da linha
                                    tension: 0.3, // Curvatura da linha (0 para linha reta)
                                    pointRadius: 6, // Tamanho dos pontos
                                    pointBackgroundColor: coresGlobal.pecas,
                                    pointHoverRadius: 8
                                }]
                            },
                            options: {
                                responsive: true,
                                plugins: {
                                    legend: {
                                        display: true,
                                        position: 'top'
                                    }
                                },
                                scales: {
                                    y: {
                                        beginAtZero: true,
                                        ticks: {
                                            // Força o eixo a usar apenas números inteiros
                                            stepSize: 1,
                                            callback: function(value) {
                                                if (Math.floor(value) === value) {
                                                    return value;
                                                }
                                            }
                                        },
                                        grid: {
                                            drawBorder: false
                                        }
                                    },
                                    x: {
                                        grid: {
                                            display: false // Remove as linhas verticais para ficar mais limpo
                                        }
                                    }
                                }
                            }
                        });
                    }

                        function criaGraficoTotalStatus(dados) {
                            const totalPorStatus = {};
                            let valorTotalGeral = 0;

                            dados.forEach(os => {
                                const valor = parseFloat(os.valorTotalGeral) || 0;
                                valorTotalGeral += valor;
                                totalPorStatus[os.status] = (totalPorStatus[os.status] || 0) + valor;
                            });

                            new Chart(document.getElementById('graficoTotal'), {
                                type: 'doughnut',
                                data: {
                                    labels: Object.keys(totalPorStatus),
                                    datasets: [{
                                        data: Object.values(totalPorStatus),
                                        backgroundColor: Object.keys(totalPorStatus).map(s => coresGlobal.status[s] || '#999')
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    plugins: {
                                        title: {
                                            display: true,
                                            text: `Faturamento Total: R$ ${valorTotalGeral.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`
                                        },
                                        tooltip: {
                                            callbacks: {
                                                label: function(context) {
                                                    let label = context.label || '';
                                                    let value = context.raw || 0;
                                                    let percentage = valorTotalGeral > 0 ? ((value / valorTotalGeral) * 100).toFixed(1) : 0;
                                                    return `${label}: R$ ${value.toLocaleString('pt-BR', { minimumFractionDigits: 2 })} (${percentage}%)`;
                                                }
                                            }
                                        }
                                    }
                                }
                            });
                        }

                        function criaGraficoItens(dados) {
                            const itemContagem = {};
                            const itemFinanceiro = {};

                            dados.forEach(os => {
                                os.itens?.forEach(item => {
                                    const nome = item.descricao || "Sem descrição";
                                    const qtd = parseFloat(item.quantidade) || 0;
                                    const valorTotal = parseFloat(item.valorTotalItem) || 0;

                                    itemContagem[nome] = (itemContagem[nome] || 0) + qtd;
                                    itemFinanceiro[nome] = (itemFinanceiro[nome] || 0) + valorTotal;
                                });
                            });

                            const itensOrdenados = Object.entries(itemContagem).sort((a, b) => b[1] - a[1]).slice(0, 10);
                            const labels = itensOrdenados.map(i => i[0]);

                            new Chart(document.getElementById('graficoItens'), {
                                type: 'bar',
                                data: {
                                    labels: labels,
                                    datasets: [{
                                        label: 'Quantidade Total',
                                        data: itensOrdenados.map(i => i[1]),
                                        backgroundColor: '#4BC0C0',
                                        financeiro: labels.map(nome => itemFinanceiro[nome])
                                    }]
                                },
                                options: {
                                    indexAxis: 'y',
                                    plugins: {
                                        tooltip: {
                                            callbacks: {
                                                footer: function (context) {
                                                    const valorRS = context[0].dataset.financeiro[context[0].dataIndex];
                                                    return `Valor Acumulado: R$ ${valorRS.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;
                                                }
                                            }
                                        }
                                    }
                                }
                            });
                        }

                        function criaGraficoComposicao(dados) {
                            const ultimasOS = dados.slice(0, 15).reverse();

                            const labels = ultimasOS.map(os => {
                                const data = new Date(os.data_inicio).toLocaleDateString('pt-BR');
                                return `${os.cliente?.nome.split(' ')[0] || 'S/N'} (${data})`;
                            });

                            const dadosPecas = ultimasOS.map(os => {
                                return os.itens.filter(i => i.tipo !== 'Serviço').reduce((acc, item) => acc + (parseFloat(item.valorTotalItem) || 0), 0);
                            });

                            const dadosMaoDeObra = ultimasOS.map(os => {
                                const fixa = parseFloat(os.mao_de_obra) || 0;
                                const itensServico = os.itens.filter(i => i.tipo === 'Serviço').reduce((acc, item) => acc + (parseFloat(item.valorTotalItem) || 0), 0);
                                return fixa + itensServico;
                            });

                            new Chart(document.getElementById('graficoComposicao'), {
                                type: 'bar',
                                data: {
                                    labels: labels,
                                    datasets: [
                                        { label: 'Peças/Produtos', data: dadosPecas, backgroundColor: coresGlobal.pecas },
                                        { label: 'Mão de Obra', data: dadosMaoDeObra, backgroundColor: coresGlobal.maoDeObra }
                                    ]
                                },
                                options: {
                                    responsive: true,
                                    layout: { padding: { top: 30 } },
                                    scales: {
                                        x: { stacked: true },
                                        y: { stacked: true, beginAtZero: true, grace: '15%' }
                                    },
                                    plugins: {
                                        tooltip: {
                                            callbacks: {
                                                label: (c) => `${c.dataset.label}: R$ ${c.parsed.y.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`
                                            }
                                        }
                                    }
                                },
                                plugins: [{
                                    id: 'datalabels',
                                    afterDraw: (chart) => {
                                        const { ctx, scales: { x, y } } = chart;
                                        ctx.save();
                                        ctx.textAlign = 'center';
                                        ctx.font = 'bold 12px Arial';
                                        ctx.fillStyle = '#333';
                                        chart.data.labels.forEach((label, index) => {
                                            const total = chart.data.datasets[0].data[index] + chart.data.datasets[1].data[index];
                                            const xPos = x.getPixelForValue(label);
                                            const yPos = y.getPixelForValue(total);
                                            if (total > 0) ctx.fillText(`R$ ${total.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`, xPos, yPos - 10);
                                        });
                                        ctx.restore();
                                    }
                                }]
                            });
                        }

                        function criaGraficoGeralComposicao(dados) {
                            let totalMaoDeObra = 0;
                            let totalPecas = 0;

                            dados.forEach(os => {
                                totalMaoDeObra += parseFloat(os.mao_de_obra) || 0;
                                os.itens?.forEach(item => {
                                    if (item.tipo === 'Serviço') {
                                        totalMaoDeObra += parseFloat(item.valorTotalItem) || 0;
                                    } else {
                                        totalPecas += parseFloat(item.valorTotalItem) || 0;
                                    }
                                });
                            });

                            const total = totalMaoDeObra + totalPecas;

                            new Chart(document.getElementById('graficoGeralComposicao'), {
                                type: 'pie',
                                data: {
                                    labels: ['Mão de Obra', 'Peças'],
                                    datasets: [{
                                        data: [totalMaoDeObra, totalPecas],
                                        backgroundColor: [coresGlobal.maoDeObra, coresGlobal.pecas]
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    plugins: {
                                        title: { 
                                            display: true, 
                                            text: `Total: R$ ${total.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}` 
                                        },
                                        tooltip: {
                                            callbacks: {
                                                label: function(context) {
                                                    let label = context.label || '';
                                                    let value = context.raw || 0;
                                                    let percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                                    return `${label}: R$ ${value.toLocaleString('pt-BR', { minimumFractionDigits: 2 })} (${percentage}%)`;
                                                }
                                            }
                                        }
                                    }
                                }
                            });
                        }

                        function criaGraficoClientesNovos(dados, dataInicioFiltro) {
                            let novos = 0, antigos = 0;
                            const clientesProcessados = new Set();
                            const ref = dataInicioFiltro ? new Date(dataInicioFiltro) : new Date(new Date().setDate(new Date().getDate() - 30));

                            dados.forEach(os => {
                                if (os.cliente?._id && !clientesProcessados.has(os.cliente._id)) {
                                    clientesProcessados.add(os.cliente._id);
                                    new Date(os.cliente.criadoEm) >= ref ? novos++ : antigos++;
                                }
                            });

                            const totalClientes = novos + antigos;

                            new Chart(document.getElementById('graficoNovosClientes'), {
                                type: 'pie',
                                data: {
                                    labels: ['Novos', 'Antigos'],
                                    datasets: [{
                                        data: [novos, antigos],
                                        backgroundColor: [coresGlobal.status['Em orçamento'], '#6c757d']
                                    }]
                                },
                                options: {
                                    plugins: {
                                        tooltip: {
                                            callbacks: {
                                                label: function(context) {
                                                    let label = context.label || '';
                                                    let value = context.raw || 0;
                                                    let percentage = totalClientes > 0 ? ((value / totalClientes) * 100).toFixed(1) : 0;
                                                    return `${label}: ${value} (${percentage}%)`;
                                                }
                                            }
                                        }
                                    }
                                }
                            });
                        }
                    </script>
                </div>
            </div>
        </div>

        <%- include('../includes/footer') %>