<%- include('../includes/head')%>
<%- include('../includes/nav')%>

<div class="container">
  <div class="row">
    <div class="col-lg-2"></div>
    
    <div class="col-lg-8 my-3">
      <h1 class="text-center">Clientes</h1>
      <p class="text-center lead">Crie ou edite seu cliente abaixo</p>

      <%- include('../includes/messages') %>

      <% if(cliente._id){ %>
        <form action="/cliente/edit/<%= cliente._id %>" method="post">
      <% } else { %>
        <form action="/cliente/register" method="post">
      <% } %>
        
        <input type="hidden" name="_csrf" value="<%=csrfToken %>">

        <div class="card shadow-sm">
          <div class="card-body">
            
            <div class="row">
              <div class="col-md-8 form-group mb-3">
                <label class="form-label">Nome Completo / Razão Social</label>
                <input type="text" value="<%= cliente.nome %>" class="form-control" name="nome" placeholder="Ex: João Silva" required>
              </div>
              <div class="col-md-4 form-group mb-3">
                <label class="form-label">CPF / CNPJ</label>
                <input type="text" value="<%= cliente.cpf_cnpj %>" class="form-control" name="cpf_cnpj" placeholder="000.000.000-00">
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 form-group mb-3">
                <label class="form-label">Telefone Principal</label>
                <input type="text" value="<%= cliente.telefone %>" class="form-control" name="telefone" placeholder="(00) 00000-0000">
              </div>
              <div class="col-md-6 form-group mb-3">
                <label class="form-label">Telefone Secundário</label>
                <input type="text" value="<%= cliente.telefone2 %>" class="form-control" name="telefone2" placeholder="(00) 00000-0000">
              </div>
            </div>

            <hr>
            <h5 class="mb-3">Endereço</h5>

            <div class="row">
              <div class="col-md-3 form-group mb-3">
                <label class="form-label">CEP</label>
                <input type="text" value="<%= cliente.cep %>" class="form-control" name="cep" placeholder="00000-000">
              </div>
              <div class="col-md-9 form-group mb-3">
                <label class="form-label">Logradouro (Rua, Av, Número)</label>
                <input type="text" value="<%= cliente.endereco %>" class="form-control" name="endereco" placeholder="Ex: Rua das Flores, 123">
              </div>
            </div>

            <div class="row">
              <div class="col-md-8 form-group mb-3">
                <label class="form-label">Cidade</label>
                <input type="text" value="<%= cliente.cidade %>" class="form-control" name="cidade" placeholder="Ex: São Paulo">
              </div>
              <div class="col-md-4 form-group mb-3">
                <label class="form-label">Estado (UF)</label>
                <input type="text" value="<%= cliente.estado %>" class="form-control" name="estado" placeholder="Ex: SP">
              </div>
            </div>

           
            <hr>
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
              <a href="/" class="btn btn-secondary mt-3">Voltar</a>
              <button type="submit" class="btn btn-primary mt-3 px-5">Salvar Cliente</button>
            </div>

          </div>
        </div>
      </form>
    </div>

    <div class="col-lg-2"></div>
  </div>
</div>

<%- include('../includes/footer')%>